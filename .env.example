# Database
DATABASE_URL=postgresql+psycopg://opsagent:localdev@localhost:5434/opsagent

# Redis (6380 because 6379 is taken by the Langfuse stack)
REDIS_URL=redis://localhost:6380/0

# Model provider
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Refund safety
REFUND_CAP_MINOR_UNITS=5000
WRITE_TOOLS_ENABLED=false
DURABLE_REFUNDS=false

#Lanfuse
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

#Sentry
SENTRY_DSN=https://...your dsn...
SENTRY_ENVIRONMENT=local
