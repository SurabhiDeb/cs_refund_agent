{
  "uid": "ops-agent",
  "title": "OpsAgent",
  "tags": ["ops-agent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Refund value per hour (minor units)",
      "description": "The alert watches this line. Above 50000 for 5 minutes and someone gets paged.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "increase(ops_agent_refund_value_minor_total[1h])",
          "legendFormat": "refunded",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Runs by decision",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (increase(ops_agent_runs_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Escalation rate (1h)",
      "description": "Computed, never stored. A stored rate is stale the moment it is written.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(ops_agent_runs_total{decision=\"escalate\"}[1h])) / clamp_min(sum(increase(ops_agent_runs_total[1h])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1 },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Gateway spend, 24h (INR)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        { "expr": "increase(ops_agent_cost_inr_total[24h])", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 2 },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Steps per run, p50 and p95",
      "description": "The limit is 8. A p95 near it means the agent is looping, not thinking.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ops_agent_steps_per_run_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ops_agent_steps_per_run_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 and p95 (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ops_agent_run_latency_seconds_bucket[30m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ops_agent_run_latency_seconds_bucket[30m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Tool refusals by code",
      "description": "Which rules are firing. A spike in one code is a prompt problem or an attack.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum by (code) (increase(ops_agent_tool_refusals_total[1h]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    }
  ]
}
